<Window x:Class="Harbor.UI.PomodoroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Harbor timer" Width="296" Height="176"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        FontFamily="{DynamicResource H.Font}" Foreground="{DynamicResource H.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- The zone is nearly invisible but still catches the pointer, because a bar this thin is hard to land on. -->
    <Border x:Name="Zone" Background="#01000000" HorizontalAlignment="Center" VerticalAlignment="Top" Padding="8" Cursor="SizeAll"
            MouseEnter="Zone_MouseEnter" MouseLeave="Zone_MouseLeave" MouseLeftButtonDown="Zone_MouseLeftButtonDown">
        <Border x:Name="Card" Width="168" Height="14" CornerRadius="18" ClipToBounds="True"
                Background="{DynamicResource H.MenuBg}" BorderBrush="{DynamicResource H.Border}" BorderThickness="1">
            <Grid>
                <Border x:Name="Mini" Width="158" Height="6" CornerRadius="3" Background="{DynamicResource H.Track}" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border x:Name="MiniFill" CornerRadius="3" HorizontalAlignment="Left" Width="158"/>
                </Border>

                <Grid x:Name="Full" Width="278" Height="156" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid Margin="18,12,12,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource H.IconButton}" Content="&#xE711;" FontSize="9" Padding="6" ToolTip="Close" Click="Close_Click" Cursor="Hand"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="PhaseText" Text="Focus" FontSize="13" Foreground="{DynamicResource H.TextDim}"/>
                                <StackPanel x:Name="Dots" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>

                        <TextBlock x:Name="TimeText" Grid.Row="1" Text="25:00" FontFamily="{DynamicResource H.Display}" FontSize="38" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,0,2"/>

                        <Border x:Name="FullTrack" Grid.Row="2" Height="5" Width="244" CornerRadius="2.5" Background="{DynamicResource H.Track}" HorizontalAlignment="Left">
                            <Border x:Name="FullFill" CornerRadius="2.5" HorizontalAlignment="Left" Width="244"/>
                        </Border>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="-6,8,0,0">
                            <Button x:Name="PlayButton" Style="{StaticResource H.IconButton}" Content="&#xE768;" FontSize="14" Padding="10,7" ToolTip="Start" Click="Play_Click" Cursor="Hand"/>
                            <Button Style="{StaticResource H.IconButton}" Content="&#xE72C;" FontSize="14" Padding="10,7" ToolTip="Reset" Click="Reset_Click" Cursor="Hand"/>
                            <Button Style="{StaticResource H.IconButton}" Content="&#xE893;" FontSize="14" Padding="10,7" ToolTip="Skip" Click="Skip_Click" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
