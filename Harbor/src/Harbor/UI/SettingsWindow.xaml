<Window x:Class="Harbor.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Harbor.UI"
        Title="Harbor" Width="1080" Height="760" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        FontFamily="{DynamicResource H.Font}" FontSize="13.5" Foreground="{DynamicResource H.Text}"
        Icon="pack://application:,,,/Assets/Harbor.ico" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="True" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource H.TextDim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,24,0"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,13"/>
        </Style>
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource H.GroupBorder}"/>
        </Style>
        <Style x:Key="SegmentHost" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource H.Hover}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Width" Value="52"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{DynamicResource H.TextDim}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ModeCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource H.Focus}"/>
            <Setter Property="Foreground" Value="{DynamicResource H.Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="10" Padding="16,14" Margin="0,0,10,0" BorderThickness="1.5"
                                Background="{DynamicResource H.Group}" BorderBrush="{DynamicResource H.GroupBorder}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource H.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar sits straight on Mica. -->
        <DockPanel Margin="14,0,10,14">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="46" Margin="6,0,0,10">
                <Image Source="pack://application:,,,/Assets/Harbor.ico" Width="20" Height="20" VerticalAlignment="Center"/>
                <TextBlock Text="Harbor" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom">
                <Border CornerRadius="8" Padding="12,10" Background="{DynamicResource H.Hover}" Margin="0,0,0,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource H.StatusAnimated}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="Animated" Margin="8,0,0,0" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusSub" Text="" Margin="16,3,0,0" FontSize="12" Foreground="{DynamicResource H.TextDim}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource H.Button}" HorizontalAlignment="Stretch" Click="Quit_Click" Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7E8;" FontFamily="{DynamicResource H.Icons}" Foreground="{DynamicResource H.Danger}" VerticalAlignment="Center"/>
                        <TextBlock Text="Quit Harbor" Margin="10,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel>
                <RadioButton x:Name="NavHome" Style="{StaticResource H.Nav}" Tag="&#xE80F;" Content="Home" IsChecked="True" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavDock" Style="{StaticResource H.Nav}" Tag="&#xE8A9;" Content="Dock" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavApps" Style="{StaticResource H.Nav}" Tag="&#xE71D;" Content="Apps" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavWallpaper" Style="{StaticResource H.Nav}" Tag="&#xE771;" Content="Wallpaper" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavPower" Style="{StaticResource H.Nav}" Tag="&#xE83F;" Content="Battery and performance" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavAbout" Style="{StaticResource H.Nav}" Tag="&#xE946;" Content="About" Checked="Nav_Checked"/>
            </StackPanel>
        </DockPanel>

        <!-- Content layer: a translucent sheet over Mica, like Windows Settings. -->
        <Border Grid.Column="1" Margin="0,46,0,0" CornerRadius="10,0,0,0" Background="{DynamicResource H.Layer}"
                BorderBrush="{DynamicResource H.LayerBorder}" BorderThickness="1,1,0,0">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="36,28,36,28">
                <Grid MaxWidth="860" HorizontalAlignment="Left" x:Name="Pages">

                    <!-- ================================================= HOME -->
                    <StackPanel x:Name="PageHome">
                        <!-- The hero is the user's own desktop: the live scene with their dock on it. -->
                        <Border x:Name="Hero" Height="300" CornerRadius="14" Background="#FF0D0F14" Cursor="Cross"
                                MouseMove="Hero_MouseMove" MouseLeave="Hero_MouseLeave" MouseLeftButtonDown="Hero_Click">
                            <Grid>
                                <Grid.Clip>
                                    <RectangleGeometry x:Name="HeroClip" RadiusX="14" RadiusY="14"/>
                                </Grid.Clip>
                                <Image x:Name="HeroImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Linear"/>
                                <Rectangle IsHitTestVisible="False">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#80000000" Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="0.42"/>
                                            <GradientStop Color="#00000000" Offset="0.7"/>
                                            <GradientStop Color="#55000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <StackPanel Margin="26,22,26,0" VerticalAlignment="Top" IsHitTestVisible="False">
                                    <TextBlock x:Name="HeroSceneName" Text="Aurora" FontFamily="{DynamicResource H.Display}" FontSize="32" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock x:Name="HeroSceneDesc" Text="" Foreground="#E6FFFFFF" FontSize="13.5" TextWrapping="Wrap" MaxWidth="440" HorizontalAlignment="Left" Margin="1,4,0,0"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,22,0" CornerRadius="12" Padding="11,5"
                                        Background="#66000000" IsHitTestVisible="False">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="HeroPillDot" Width="7" Height="7" Fill="{DynamicResource H.StatusAnimated}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="HeroPillText" Text="Animated" Foreground="White" FontSize="12.5" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ui:MiniDock x:Name="HeroDock" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                                <TextBlock Text="Move the pointer here to play with it" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                           Margin="24,0,0,16" Foreground="#99FFFFFF" FontSize="12" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Motion" Style="{StaticResource H.SectionTitle}" Margin="2,24,0,10"/>
                        <UniformGrid Columns="3" Margin="0,0,-10,6">
                            <RadioButton x:Name="HomeSmart" GroupName="HomeMode" Style="{StaticResource ModeCard}" Click="HomeMode_Click">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9F5;" FontFamily="{DynamicResource H.Icons}" FontSize="16" Foreground="{DynamicResource H.Accent}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Smart" FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Moves when you can see it and power allows; rests otherwise." Style="{StaticResource RowDesc}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="HomeAnimated" GroupName="HomeMode" Style="{StaticResource ModeCard}" Click="HomeMode_Click">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="{DynamicResource H.Icons}" FontSize="16" Foreground="{DynamicResource H.Accent}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Always animated" FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Keeps moving on battery too. Still pauses when nothing is visible." Style="{StaticResource RowDesc}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="HomeStatic" GroupName="HomeMode" Style="{StaticResource ModeCard}" Click="HomeMode_Click">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE769;" FontFamily="{DynamicResource H.Icons}" FontSize="16" Foreground="{DynamicResource H.Accent}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Static" FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="A still frame of your scene. Uses no graphics power at all." Style="{StaticResource RowDesc}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                        <Border CornerRadius="8" Padding="14,10" Background="{DynamicResource H.Hover}" Margin="0,4,0,8">
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="Right now: " Foreground="{DynamicResource H.TextDim}"/><Run x:Name="HomeNowTitle" Text="Animated" FontWeight="SemiBold"/><Run Text=". "/><Run x:Name="HomeNowDetail" Text="" Foreground="{DynamicResource H.TextDim}"/>
                            </TextBlock>
                        </Border>

                        <TextBlock Text="Quick settings" Style="{StaticResource H.SectionTitle}" Margin="2,20,0,10"/>
                        <Border Style="{StaticResource H.Panel}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="React to the pointer" Style="{StaticResource RowTitle}"/><TextBlock Text="Light, parallax and ripples follow your mouse on the desktop." Style="{StaticResource RowDesc}"/></StackPanel>
                                    <CheckBox x:Name="QuickPointer" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Quick_Click"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="React to music" Style="{StaticResource RowTitle}"/><TextBlock Text="Scenes pulse with whatever your PC is playing. Sound is analysed live and never recorded." Style="{StaticResource RowDesc}"/></StackPanel>
                                    <CheckBox x:Name="QuickMusic" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Quick_Click"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Window previews" Style="{StaticResource RowTitle}"/><TextBlock Text="Hover a running app in the dock to see its windows live." Style="{StaticResource RowDesc}"/></StackPanel>
                                    <CheckBox x:Name="QuickPreviews" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Quick_Click"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Hide the Windows taskbar" Style="{StaticResource RowTitle}"/><TextBlock Text="Harbor puts it back when it quits, even after a crash." Style="{StaticResource RowDesc}"/></StackPanel>
                                    <CheckBox x:Name="QuickTaskbar" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Quick_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================================================= DOCK -->
                    <StackPanel x:Name="PageDock" Visibility="Collapsed">
                        <TextBlock Text="Dock" Style="{StaticResource H.PageTitle}"/>
                        <TextBlock Text="Hover the preview to try the magnification as you adjust it." Style="{StaticResource H.PageLead}"/>
                        <Border CornerRadius="14" Height="170" Margin="0,0,0,18" Background="#FF101219">
                            <Grid>
                                <Grid.Clip>
                                    <RectangleGeometry x:Name="StageClip" RadiusX="14" RadiusY="14"/>
                                </Grid.Clip>
                                <Image x:Name="DockStageImage" Stretch="UniformToFill" Opacity="0.85"/>
                                <ui:MiniDock x:Name="DockPreview" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Appearance" Style="{StaticResource H.SectionTitle}"/>
                        <Border Style="{StaticResource H.Panel}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Icon size" Style="{StaticResource RowTitle}"/><TextBlock Text="Ctrl + scroll on the dock also resizes it." Style="{StaticResource RowDesc}"/></StackPanel>
                                    <DockPanel Grid.Column="1"><TextBlock x:Name="IconSizeValue" DockPanel.Dock="Right" Style="{StaticResource ValueText}"/>
                                        <Slider x:Name="IconSize" Style="{StaticResource H.Slider}" Minimum="28" Maximum="96" SmallChange="2" LargeChange="8" ValueChanged="Dock_Changed"/></DockPanel>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Magnification" Style="{StaticResource RowTitle}"/><TextBlock Text="Icons swell under the pointer and push their neighbours aside." Style="{StaticResource RowDesc}"/></StackPanel>
                                    <CheckBox x:Name="Magnify" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Dock_Changed"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Magnification amount" Style="{StaticResource RowTitle}"/>
                                    <DockPanel Grid.Column="1"><TextBlock x:Name="MagnifyValue" DockPanel.Dock="Right" Style="{StaticResource ValueText}"/>
                                        <Slider x:Name="MagnifyAmount" Style="{StaticResource H.Slider}" Minimum="0.1" Maximum="1.2" ValueChanged="Dock_Changed"/></DockPanel>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Theme" Style="{StaticResource RowTitle}"/>
                                    <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ThemeSystem" GroupName="Theme" Style="{StaticResource H.Segment}" Content="System" Click="Dock_Changed"/>
                                            <RadioButton x:Name="ThemeDark" GroupName="Theme" Style="{StaticResource H.Segment}" Content="Dark" Click="Dock_Changed"/>
                                            <RadioButton x:Name="ThemeLight" GroupName="Theme" Style="{StaticResource H.Segment}" Content="Light" Click="Dock_Changed"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Glass tint" Style="{StaticResource RowTitle}"/><TextBlock Text="Lower lets more of the blurred desktop show through." Style="{StaticResource RowDesc}"/></StackPanel>
                                    <DockPanel Grid.Column="1"><TextBlock x:Name="TintValue" DockPanel.Dock="Right" Style="{StaticResource ValueText}"/>
                                        <Slider x:Name="Tint" Style="{StaticResource H.Slider}" Minimum="0.05" Maximum="1" ValueChanged="Dock_Changed"/></DockPanel>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Corner roundness" Style="{StaticResource RowTitle}"/>
                                    <DockPanel Grid.Column="1"><TextBlock x:Name="RoundValue" DockPanel.Dock="Right" Style="{StaticResource ValueText}"/>
                                        <Slider x:Name="Roundness" Style="{StaticResource H.Slider}" Minimum="0.12" Maximum="0.5" ValueChanged="Dock_Changed"/></DockPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Behaviour" Style="{StaticResource H.SectionTitle}"/>
                        <Border Style="{StaticResource H.Panel}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Auto-hide" Style="{StaticResource RowTitle}"/><TextBlock Text="Never keeps the dock on top of every app. The others tuck it away; rest the pointer at the bottom edge to bring it back." Style="{StaticResource RowDesc}"/></StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="HideNever" GroupName="Hide" Style="{StaticResource H.Segment}" Content="Never" Click="Dock_Changed"/>
                                            <RadioButton x:Name="HideOverlap" GroupName="Hide" Style="{StaticResource H.Segment}" Content="When covered" Click="Dock_Changed"/>
                                            <RadioButton x:Name="HideAlways" GroupName="Hide" Style="{StaticResource H.Segment}" Content="Always" Click="Dock_Changed"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Hide the Windows taskbar" Style="{StaticResource RowTitle}"/><TextBlock Text="Restored automatically when Harbor quits, and on the next start if Harbor ever crashes." Style="{StaticResource RowDesc}"/></StackPanel>
                                    <CheckBox x:Name="HideTaskbar" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Dock_Changed"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Hide during fullscreen apps and games" Style="{StaticResource RowTitle}"/>
                                    <CheckBox x:Name="HideFullscreen" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Dock_Changed"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Window previews" Style="{StaticResource RowTitle}"/><TextBlock Text="Live thumbnails above a running app. Click one to switch to it." Style="{StaticResource RowDesc}"/></StackPanel>
                                    <CheckBox x:Name="Previews" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Dock_Changed"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Bounce icons while apps launch" Style="{StaticResource RowTitle}"/>
                                    <CheckBox x:Name="Bounce" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Dock_Changed"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Show app names on hover" Style="{StaticResource RowTitle}"/>
                                    <CheckBox x:Name="Labels" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Dock_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Items" Style="{StaticResource H.SectionTitle}"/>
                        <Border Style="{StaticResource H.Panel}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Harbor button" Style="{StaticResource RowTitle}"/><TextBlock Text="Hover it for volume, brightness, battery and wallpaper motion. Click it to open Harbor." Style="{StaticResource RowDesc}"/></StackPanel>
                                    <CheckBox x:Name="ShowHarbor" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Dock_Changed"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Clock" Style="{StaticResource RowTitle}"/><TextBlock Text="The time and date at the end of the dock. Hover it for a calendar." Style="{StaticResource RowDesc}"/></StackPanel>
                                    <CheckBox x:Name="ShowClockToggle" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Dock_Changed"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Show on all screens" Style="{StaticResource RowTitle}"/><TextBlock Text="A dock on every screen, with the same apps. Off keeps it on the main screen." Style="{StaticResource RowDesc}"/></StackPanel>
                                    <CheckBox x:Name="ShowAllScreens" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Dock_Changed"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Start button" Style="{StaticResource RowTitle}"/>
                                    <CheckBox x:Name="ShowStart" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Dock_Changed"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Now Playing" Style="{StaticResource RowTitle}"/><TextBlock Text="Album art of what's playing. Click to play or pause, scroll to skip." Style="{StaticResource RowDesc}"/></StackPanel>
                                    <CheckBox x:Name="ShowMedia" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Dock_Changed"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Recycle Bin" Style="{StaticResource RowTitle}"/>
                                    <CheckBox x:Name="ShowBin" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Dock_Changed"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Running indicators" Style="{StaticResource RowTitle}"/><TextBlock Text="A dot under running apps; the active app gets an accent pill." Style="{StaticResource RowDesc}"/></StackPanel>
                                    <CheckBox x:Name="Indicators" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Dock_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================================================= APPS -->
                    <StackPanel x:Name="PageApps" Visibility="Collapsed">
                        <TextBlock Text="Apps" Style="{StaticResource H.PageTitle}"/>
                        <TextBlock Text="Choose what lives in the dock. You can also drag icons in the dock to reorder them, or drag one up and away to remove it." Style="{StaticResource H.PageLead}"/>
                        <DockPanel Margin="0,0,0,4">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource H.Button}" Click="ImportTaskbar_Click" Margin="0,0,8,0">Import taskbar pins</Button>
                                <Button Style="{StaticResource H.Button}" Click="Browse_Click">Add a program...</Button>
                            </StackPanel>
                            <TextBlock Text="In the dock" Style="{StaticResource H.SectionTitle}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border Style="{StaticResource H.Panel}" Padding="8,6">
                            <StackPanel>
                                <TextBlock x:Name="NoPins" Text="Nothing pinned yet. Pin apps from the list below, or right-click a running app in the dock and choose Keep in Dock."
                                           Style="{StaticResource RowDesc}" Margin="10,12"/>
                                <ItemsControl x:Name="PinnedList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="10,6" Background="Transparent" x:Name="RowBd">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Style="{StaticResource H.IconButton}" Content="&#xE70E;" ToolTip="Move up" Click="PinUp_Click" Tag="{Binding}"/>
                                                        <Button Style="{StaticResource H.IconButton}" Content="&#xE70D;" ToolTip="Move down" Click="PinDown_Click" Tag="{Binding}"/>
                                                        <Button Style="{StaticResource H.IconButton}" Content="&#xE711;" ToolTip="Remove from dock" Click="PinRemove_Click" Tag="{Binding}"/>
                                                    </StackPanel>
                                                    <Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"/>
                                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource H.TextDim}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="RowBd" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource H.Hover}"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="All apps" Style="{StaticResource H.SectionTitle}"/>
                        <Border Style="{StaticResource H.Panel}" Padding="12">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBox x:Name="Search" Style="{StaticResource H.TextBox}" TextChanged="Search_TextChanged"/>
                                    <TextBlock Text="Search apps" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource H.TextDim}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <ListBox x:Name="AllApps" Height="360" Background="Transparent" BorderThickness="0"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd" CornerRadius="7" Padding="8,5" Background="Transparent">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Hover}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource H.Button}" Padding="12,4" Click="PinApp_Click" Tag="{Binding}">
                                                    <TextBlock Text="{Binding PinLabel}"/>
                                                </Button>
                                                <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource H.Text}" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================================================= WALLPAPER -->
                    <StackPanel x:Name="PageWallpaper" Visibility="Collapsed">
                        <DockPanel>
                            <CheckBox x:Name="WpEnabled" DockPanel.Dock="Right" Style="{StaticResource H.Toggle}" Click="Wallpaper_Changed" VerticalAlignment="Center" ToolTip="Live wallpaper on or off"/>
                            <TextBlock Text="Wallpaper" Style="{StaticResource H.PageTitle}"/>
                        </DockPanel>
                        <TextBlock Text="Every scene is drawn live at your screen's native resolution, up to 4K and beyond, and reacts to your pointer." Style="{StaticResource H.PageLead}"/>

                        <ItemsControl x:Name="SceneGallery" Margin="0,0,-12,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" Width="198" Margin="0,0,12,14" CornerRadius="10" BorderThickness="2" Cursor="Hand"
                                            Background="{DynamicResource H.Group}" BorderBrush="Transparent"
                                            MouseLeftButtonUp="Scene_Click" Tag="{Binding}">
                                        <StackPanel>
                                            <Border CornerRadius="8,8,0,0" Height="111" ClipToBounds="True" Background="#FF101014">
                                                <Grid>
                                                    <Image Source="{Binding Preview}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <TextBlock Text="&#xE714;" FontFamily="{DynamicResource H.Icons}" FontSize="28" Foreground="#99FFFFFF"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding VideoGlyph}"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Margin="12,9,12,11">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CostLabel}" FontSize="11.5" Foreground="{DynamicResource H.TextDim}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource RowDesc}" Margin="0,3,0,0" Height="34" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource H.Accent}"/>
                                        </DataTrigger>
                                        <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource H.Hover}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource H.Panel}">
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Your video" Style="{StaticResource RowTitle}"/>
                                    <TextBlock x:Name="VideoPathText" Text="No video chosen. MP4, MOV, MKV and WMV work, 4K included." Style="{StaticResource RowDesc}" TextTrimming="CharacterEllipsis"/></StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource H.Button}" Click="ChooseVideo_Click" VerticalAlignment="Center">Choose video...</Button>
                            </Grid>
                        </Border>

                        <TextBlock Text="Interaction" Style="{StaticResource H.SectionTitle}"/>
                        <Border Style="{StaticResource H.Panel}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="React to the pointer" Style="{StaticResource RowTitle}"/><TextBlock Text="Parallax and light follow the pointer; clicking the desktop sends a ripple." Style="{StaticResource RowDesc}"/></StackPanel>
                                    <CheckBox x:Name="WpInteractive" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Wallpaper_Changed"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Pointer strength" Style="{StaticResource RowTitle}"/>
                                    <DockPanel Grid.Column="1"><TextBlock x:Name="StrengthValue" DockPanel.Dock="Right" Style="{StaticResource ValueText}"/>
                                        <Slider x:Name="WpStrength" Style="{StaticResource H.Slider}" Minimum="0" Maximum="2" ValueChanged="Wallpaper_Changed"/></DockPanel>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="React to music" Style="{StaticResource RowTitle}"/><TextBlock Text="Bass, mids and treble from whatever is playing drive the scene. Never recorded." Style="{StaticResource RowDesc}"/></StackPanel>
                                    <CheckBox x:Name="WpMusic" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Wallpaper_Changed"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Animation speed" Style="{StaticResource RowTitle}"/>
                                    <DockPanel Grid.Column="1"><TextBlock x:Name="SpeedValue" DockPanel.Dock="Right" Style="{StaticResource ValueText}"/>
                                        <Slider x:Name="WpSpeed" Style="{StaticResource H.Slider}" Minimum="0.2" Maximum="2.5" ValueChanged="Wallpaper_Changed"/></DockPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource H.Button}" Padding="10,3" Click="ResetColor_Click" VerticalAlignment="Center">Reset</Button>
                            <TextBlock Text="Colour" Style="{StaticResource H.SectionTitle}"/>
                        </DockPanel>
                        <Border Style="{StaticResource H.Panel}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Hue shift" Style="{StaticResource RowTitle}"/>
                                    <DockPanel Grid.Column="1"><TextBlock x:Name="HueValue" DockPanel.Dock="Right" Style="{StaticResource ValueText}"/>
                                        <Slider x:Name="WpHue" Style="{StaticResource H.Slider}" Minimum="-180" Maximum="180" ValueChanged="Wallpaper_Changed"/></DockPanel>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Saturation" Style="{StaticResource RowTitle}"/>
                                    <DockPanel Grid.Column="1"><TextBlock x:Name="SatValue" DockPanel.Dock="Right" Style="{StaticResource ValueText}"/>
                                        <Slider x:Name="WpSat" Style="{StaticResource H.Slider}" Minimum="0" Maximum="2" ValueChanged="Wallpaper_Changed"/></DockPanel>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Brightness" Style="{StaticResource RowTitle}"/>
                                    <DockPanel Grid.Column="1"><TextBlock x:Name="BrightValue" DockPanel.Dock="Right" Style="{StaticResource ValueText}"/>
                                        <Slider x:Name="WpBright" Style="{StaticResource H.Slider}" Minimum="0.4" Maximum="1.6" ValueChanged="Wallpaper_Changed"/></DockPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================================================= POWER -->
                    <StackPanel x:Name="PagePower" Visibility="Collapsed">
                        <TextBlock Text="Battery and performance" Style="{StaticResource H.PageTitle}"/>
                        <TextBlock Text="Harbor only spends power on motion you can actually see. These rules decide when it moves, slows down, freezes or stops." Style="{StaticResource H.PageLead}"/>

                        <Border CornerRadius="10" Padding="18,14" Background="{DynamicResource H.Hover}" Margin="0,0,0,18">
                            <DockPanel>
                                <Ellipse x:Name="PowerDot" DockPanel.Dock="Left" Width="10" Height="10" Margin="0,7,14,0" VerticalAlignment="Top" Fill="{DynamicResource H.StatusAnimated}"/>
                                <StackPanel>
                                    <TextBlock x:Name="PowerTitle" Text="Animated" FontFamily="{DynamicResource H.Display}" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="PowerDetail" Text="" Style="{StaticResource RowDesc}" FontSize="13"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="Mode" Style="{StaticResource H.SectionTitle}"/>
                        <Border Style="{StaticResource H.Panel}">
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Motion" Style="{StaticResource RowTitle}"/><TextBlock Text="Smart follows every rule below. Always animated ignores battery and idle rules. Static never moves." Style="{StaticResource RowDesc}"/></StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ModeSmart" GroupName="Mode" Style="{StaticResource H.Segment}" Content="Smart" Click="Wallpaper_Changed"/>
                                        <RadioButton x:Name="ModeAnimated" GroupName="Mode" Style="{StaticResource H.Segment}" Content="Always animated" Click="Wallpaper_Changed"/>
                                        <RadioButton x:Name="ModeStatic" GroupName="Mode" Style="{StaticResource H.Segment}" Content="Static" Click="Wallpaper_Changed"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Text="On battery" Style="{StaticResource H.SectionTitle}"/>
                        <Border Style="{StaticResource H.Panel}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="When unplugged" Style="{StaticResource RowTitle}"/><TextBlock Text="Eco keeps the scene alive at a lower frame rate and resolution, roughly a third of the cost." Style="{StaticResource RowDesc}"/></StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="BatEco" GroupName="Bat" Style="{StaticResource H.Segment}" Content="Eco" Click="Wallpaper_Changed"/>
                                            <RadioButton x:Name="BatStatic" GroupName="Bat" Style="{StaticResource H.Segment}" Content="Static" Click="Wallpaper_Changed"/>
                                            <RadioButton x:Name="BatFull" GroupName="Bat" Style="{StaticResource H.Segment}" Content="Full" Click="Wallpaper_Changed"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Freeze below" Style="{StaticResource RowTitle}"/><TextBlock Text="Under this charge the wallpaper goes static whatever the setting above." Style="{StaticResource RowDesc}"/></StackPanel>
                                    <DockPanel Grid.Column="1"><TextBlock x:Name="BatLimitValue" DockPanel.Dock="Right" Style="{StaticResource ValueText}"/>
                                        <Slider x:Name="BatLimit" Style="{StaticResource H.Slider}" Minimum="0" Maximum="80" SmallChange="5" LargeChange="10" ValueChanged="Wallpaper_Changed"/></DockPanel>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Freeze when Energy Saver is on" Style="{StaticResource RowTitle}"/>
                                    <CheckBox x:Name="WpSaver" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Wallpaper_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="When nobody is looking" Style="{StaticResource H.SectionTitle}"/>
                        <Border Style="{StaticResource H.Panel}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Freeze when I'm away" Style="{StaticResource RowTitle}"/><TextBlock Text="After this long without keyboard or mouse input. It resumes the moment you're back." Style="{StaticResource RowDesc}"/></StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="Idle0" GroupName="Idle" Style="{StaticResource H.Segment}" Content="Never" Click="Wallpaper_Changed"/>
                                            <RadioButton x:Name="Idle2" GroupName="Idle" Style="{StaticResource H.Segment}" Content="2 min" Click="Wallpaper_Changed"/>
                                            <RadioButton x:Name="Idle5" GroupName="Idle" Style="{StaticResource H.Segment}" Content="5 min" Click="Wallpaper_Changed"/>
                                            <RadioButton x:Name="Idle15" GroupName="Idle" Style="{StaticResource H.Segment}" Content="15 min" Click="Wallpaper_Changed"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Pause when windows cover the desktop" Style="{StaticResource RowTitle}"/><TextBlock Text="Each monitor stops on its own while its desktop is hidden." Style="{StaticResource RowDesc}"/></StackPanel>
                                    <CheckBox x:Name="WpCovered" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Wallpaper_Changed"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Pause during fullscreen apps and games" Style="{StaticResource RowTitle}"/>
                                    <CheckBox x:Name="WpFullscreen" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Wallpaper_Changed"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Pause while the PC is locked" Style="{StaticResource RowTitle}"/>
                                    <CheckBox x:Name="WpLocked" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Wallpaper_Changed"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Quality" Style="{StaticResource H.SectionTitle}"/>
                        <Border Style="{StaticResource H.Panel}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Frame rate while you interact" Style="{StaticResource RowTitle}"/><TextBlock Text="Used while the pointer moves over the desktop or music is playing." Style="{StaticResource RowDesc}"/></StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="Fps30" GroupName="Fps" Style="{StaticResource H.Segment}" Content="30" Click="Wallpaper_Changed"/>
                                            <RadioButton x:Name="Fps60" GroupName="Fps" Style="{StaticResource H.Segment}" Content="60" Click="Wallpaper_Changed"/>
                                            <RadioButton x:Name="Fps120" GroupName="Fps" Style="{StaticResource H.Segment}" Content="120" Click="Wallpaper_Changed"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Frame rate for ambient motion" Style="{StaticResource RowTitle}"/><TextBlock Text="The rest of the time. Slow scenes look the same at half the cost." Style="{StaticResource RowDesc}"/></StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="Amb15" GroupName="Amb" Style="{StaticResource H.Segment}" Content="15" Click="Wallpaper_Changed"/>
                                            <RadioButton x:Name="Amb24" GroupName="Amb" Style="{StaticResource H.Segment}" Content="24" Click="Wallpaper_Changed"/>
                                            <RadioButton x:Name="Amb30" GroupName="Amb" Style="{StaticResource H.Segment}" Content="30" Click="Wallpaper_Changed"/>
                                            <RadioButton x:Name="Amb60" GroupName="Amb" Style="{StaticResource H.Segment}" Content="60" Click="Wallpaper_Changed"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Render resolution" Style="{StaticResource RowTitle}"/><TextBlock Text="Native draws every pixel, true 4K on a 4K screen. Lower values upscale smoothly and cost far less." Style="{StaticResource RowDesc}"/></StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="Res100" GroupName="Res" Style="{StaticResource H.Segment}" Content="Native" Click="Wallpaper_Changed"/>
                                            <RadioButton x:Name="Res75" GroupName="Res" Style="{StaticResource H.Segment}" Content="75%" Click="Wallpaper_Changed"/>
                                            <RadioButton x:Name="Res50" GroupName="Res" Style="{StaticResource H.Segment}" Content="50%" Click="Wallpaper_Changed"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ================================================= ABOUT -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <Image x:Name="AboutIcon" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Harbor" FontFamily="{DynamicResource H.Display}" FontSize="30" FontWeight="SemiBold"/>
                                <TextBlock x:Name="AboutVersion" Foreground="{DynamicResource H.TextDim}"/>
                                <TextBlock Text="Made by Yusuf Yunus" ToolTip="MUHAHAHAHHHA" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Style="{StaticResource H.Panel}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Start Harbor when I sign in" Style="{StaticResource RowTitle}"/>
                                    <CheckBox x:Name="Autostart" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Autostart_Click"/>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Settings and logs" Style="{StaticResource RowTitle}"/><TextBlock x:Name="SettingsPath" Style="{StaticResource RowDesc}"/></StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource H.Button}" Click="OpenSettingsFolder_Click" Margin="0,0,8,0">Open folder</Button>
                                        <Button Style="{StaticResource H.Button}" Click="OpenLog_Click">Open log</Button>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Open-source licenses" Style="{StaticResource RowTitle}"/><TextBlock Text="The libraries Harbor is built with, and their terms." Style="{StaticResource RowDesc}"/></StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource H.Button}" VerticalAlignment="Center" Click="OpenNotices_Click">View</Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Credits" Style="{StaticResource H.SectionTitle}"/>
                        <Border Style="{StaticResource H.Panel}" Padding="18,14">
                            <TextBlock Style="{StaticResource RowDesc}" Margin="0" LineHeight="20">
                                Harbor is made by Yusuf Yunus. Inspired by WinDock by Ihsan Maulana Hamdani (MIT). Desktop attach and pause rules informed by Lively Wallpaper, Seelen UI and LuminWallpaper; window tracking, activation and taskbar handling informed by ManagedShell and RetroBar, Nectar, aero-dock and OneTaskBar. All code here was written from scratch.
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
