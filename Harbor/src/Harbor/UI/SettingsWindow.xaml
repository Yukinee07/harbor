<Window x:Class="Harbor.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Harbor.UI"
        Title="Harbor" Width="900" Height="700" MinWidth="720" MinHeight="520"
        WindowStartupLocation="Manual" Background="Transparent"
        FontFamily="{DynamicResource H.Font}" FontSize="13.5" Foreground="{DynamicResource H.Text}"
        Icon="pack://application:,,,/Assets/Harbor.ico" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="60" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="True" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,11"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource H.TextDim}"/>
            <Setter Property="Margin" Value="4,14,0,8"/>
        </Style>
        <Style x:Key="SegmentHost" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource H.Hover}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Just the name and four places to go. -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="22,0,0,0">
            <Image Source="pack://application:,,,/Assets/Harbor.ico" Width="22" Height="22" VerticalAlignment="Center"/>
            <TextBlock Text="Harbor" FontFamily="{DynamicResource H.Display}" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Center" CornerRadius="14" Padding="4" WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="NavWallpaper" Style="{StaticResource H.Tab}" Content="Wallpaper" IsChecked="True" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavDock" Style="{StaticResource H.Tab}" Content="Dock" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavApps" Style="{StaticResource H.Tab}" Content="Apps" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavGeneral" Style="{StaticResource H.Tab}" Content="General" Checked="Nav_Checked"/>
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="760" Margin="28,6,28,30" x:Name="Pages">

                <!-- ================================================= WALLPAPER -->
                <StackPanel x:Name="PageWallpaper">
                    <Border x:Name="Hero" Height="300" CornerRadius="18" Background="#FF0D0F14" Cursor="Cross"
                            MouseMove="Hero_MouseMove" MouseLeave="Hero_MouseLeave" MouseLeftButtonDown="Hero_Click">
                        <Grid>
                            <Grid.Clip>
                                <RectangleGeometry x:Name="HeroClip" RadiusX="18" RadiusY="18"/>
                            </Grid.Clip>
                            <Image x:Name="HeroImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Linear"/>
                            <Rectangle IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#70000000" Offset="0"/>
                                        <GradientStop Color="#00000000" Offset="0.36"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock x:Name="HeroSceneName" Text="Aurora" Margin="24,18,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" IsHitTestVisible="False"
                                       FontFamily="{DynamicResource H.Display}" FontSize="26" FontWeight="SemiBold" Foreground="White"/>
                            <ui:MiniDock x:Name="HeroDock" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                        </Grid>
                    </Border>

                    <Grid Margin="4,16,2,6">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="HomeNowDetail" Foreground="{DynamicResource H.TextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
                        <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="HomeSmart" GroupName="Mode" Style="{StaticResource H.Segment}" Content="Smart" Click="Wallpaper_Changed" ToolTip="Moves when you can see it and power allows"/>
                                <RadioButton x:Name="HomeAnimated" GroupName="Mode" Style="{StaticResource H.Segment}" Content="Always moving" Click="Wallpaper_Changed"/>
                                <RadioButton x:Name="HomeStatic" GroupName="Mode" Style="{StaticResource H.Segment}" Content="Still" Click="Wallpaper_Changed"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ItemsControl x:Name="SceneGallery" Margin="-6,8,-6,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="6" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="Scene_Click" Tag="{Binding}" ToolTip="{Binding Description}">
                                    <StackPanel>
                                        <Grid>
                                            <Border x:Name="Picture" CornerRadius="12" Height="98" Background="#FF101014">
                                                <Border.Clip>
                                                    <RectangleGeometry Rect="0,0,1000,98" RadiusX="12" RadiusY="12"/>
                                                </Border.Clip>
                                                <Grid>
                                                    <Image Source="{Binding Preview}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <TextBlock Text="&#xE714;" FontFamily="{DynamicResource H.Icons}" FontSize="24" Foreground="#99FFFFFF"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding VideoGlyph}"/>
                                                </Grid>
                                            </Border>
                                            <Border x:Name="Ring" CornerRadius="12" BorderThickness="2.5" BorderBrush="{DynamicResource H.Accent}" Visibility="Collapsed"/>
                                        </Grid>
                                        <TextBlock x:Name="Label" Text="{Binding Name}" FontSize="12.5" Margin="3,7,0,2" Foreground="{DynamicResource H.TextDim}"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource H.Text}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="VideoRow" Style="{StaticResource H.Panel}" Visibility="Collapsed">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="VideoPathText" Text="No video chosen" Style="{StaticResource RowTitle}" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
                            <Button Grid.Column="1" Style="{StaticResource H.Button}" Click="ChooseVideo_Click" VerticalAlignment="Center">Choose video</Button>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource H.Panel}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Live wallpaper" Style="{StaticResource RowTitle}"/>
                                <CheckBox x:Name="WpEnabled" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Wallpaper_Changed"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="React to my mouse" Style="{StaticResource RowTitle}"/>
                                <CheckBox x:Name="WpInteractive" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Wallpaper_Changed"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="React to music" Style="{StaticResource RowTitle}"/>
                                <CheckBox x:Name="WpMusic" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Wallpaper_Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================================================= DOCK -->
                <StackPanel x:Name="PageDock" Visibility="Collapsed">
                    <Border CornerRadius="18" Height="160" Margin="0,0,0,14" Background="#FF101219">
                        <Grid>
                            <Grid.Clip>
                                <RectangleGeometry x:Name="StageClip" RadiusX="18" RadiusY="18"/>
                            </Grid.Clip>
                            <Image x:Name="DockStageImage" Stretch="UniformToFill"/>
                            <ui:MiniDock x:Name="DockPreview" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource H.Panel}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Size" Style="{StaticResource RowTitle}"/>
                                <Slider x:Name="IconSize" Grid.Column="1" Style="{StaticResource H.Slider}" Minimum="28" Maximum="96" SmallChange="2" LargeChange="8" ValueChanged="Dock_Changed"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Magnification" Style="{StaticResource RowTitle}"/>
                                <Slider x:Name="MagnifyAmount" Grid.Column="1" Style="{StaticResource H.Slider}" Minimum="0" Maximum="1.2" ValueChanged="Dock_Changed"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Theme" Style="{StaticResource RowTitle}"/>
                                <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ThemeSystem" GroupName="Theme" Style="{StaticResource H.Segment}" Content="Auto" Click="Dock_Changed"/>
                                        <RadioButton x:Name="ThemeDark" GroupName="Theme" Style="{StaticResource H.Segment}" Content="Dark" Click="Dock_Changed"/>
                                        <RadioButton x:Name="ThemeLight" GroupName="Theme" Style="{StaticResource H.Segment}" Content="Light" Click="Dock_Changed"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Auto-hide" Style="{StaticResource RowTitle}"/>
                                <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="HideNever" GroupName="Hide" Style="{StaticResource H.Segment}" Content="Never" Click="Dock_Changed"/>
                                        <RadioButton x:Name="HideOverlap" GroupName="Hide" Style="{StaticResource H.Segment}" Content="When covered" Click="Dock_Changed"/>
                                        <RadioButton x:Name="HideAlways" GroupName="Hide" Style="{StaticResource H.Segment}" Content="Always" Click="Dock_Changed"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Options" Style="{StaticResource Heading}"/>
                    <Border Style="{StaticResource H.Panel}">
                        <UniformGrid Columns="2">
                            <Grid Style="{StaticResource Row}" Margin="0,11,24,11">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Hide Windows taskbar" Style="{StaticResource RowTitle}"/>
                                <CheckBox x:Name="HideTaskbar" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Dock_Changed"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}" Margin="24,11,0,11">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Dock on every screen" Style="{StaticResource RowTitle}"/>
                                <CheckBox x:Name="ShowAllScreens" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Dock_Changed"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}" Margin="0,11,24,11">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Window previews" Style="{StaticResource RowTitle}"/>
                                <CheckBox x:Name="Previews" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Dock_Changed"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}" Margin="24,11,0,11">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Clock and calendar" Style="{StaticResource RowTitle}"/>
                                <CheckBox x:Name="ShowClockToggle" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Dock_Changed"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}" Margin="0,11,24,11">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Now Playing" Style="{StaticResource RowTitle}"/>
                                <CheckBox x:Name="ShowMedia" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Dock_Changed"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}" Margin="24,11,0,11">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Recycle Bin" Style="{StaticResource RowTitle}"/>
                                <CheckBox x:Name="ShowBin" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Dock_Changed"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}" Margin="0,11,24,11">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Start button" Style="{StaticResource RowTitle}"/>
                                <CheckBox x:Name="ShowStart" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Dock_Changed"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}" Margin="24,11,0,11">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Harbor button" Style="{StaticResource RowTitle}"/>
                                <CheckBox x:Name="ShowHarbor" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Dock_Changed"/>
                            </Grid>
                        </UniformGrid>
                    </Border>
                </StackPanel>

                <!-- ================================================= APPS -->
                <StackPanel x:Name="PageApps" Visibility="Collapsed">
                    <TextBlock Text="In your dock" Style="{StaticResource Heading}" Margin="4,2,0,8"/>
                    <Border Style="{StaticResource H.Panel}" Padding="10">
                        <StackPanel>
                            <TextBlock x:Name="NoPins" Text="Nothing here yet. Pin something from the list below." Foreground="{DynamicResource H.TextDim}" Margin="10,12"/>
                            <ItemsControl x:Name="PinnedList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Tile" Width="84" Height="84" CornerRadius="12" Background="Transparent" ToolTip="{Binding Name}">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <Image Source="{Binding Icon}" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="11.5" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,6,6,0"/>
                                                </StackPanel>
                                                <Button x:Name="Remove" Style="{StaticResource H.IconButton}" Content="&#xE711;" FontSize="9" Padding="5" ToolTip="Remove from dock"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Click="PinRemove_Click" Tag="{Binding}" Visibility="Hidden"/>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource H.Hover}"/>
                                                <Setter TargetName="Remove" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,10,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="Search" Style="{StaticResource H.TextBox}" TextChanged="Search_TextChanged"/>
                            <TextBlock Text="Search your apps" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource H.TextDim}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Grid.Column="1" Style="{StaticResource H.Button}" Click="Browse_Click" Margin="10,0,0,0">Add a program</Button>
                    </Grid>
                    <Border Style="{StaticResource H.Panel}" Padding="8">
                        <ListBox x:Name="AllApps" Height="320" Background="Transparent" BorderThickness="0"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" CornerRadius="9" Padding="8,6" Background="Transparent">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource H.Hover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource H.Button}" Padding="14,4" Click="PinApp_Click" Tag="{Binding}">
                                            <TextBlock Text="{Binding PinLabel}"/>
                                        </Button>
                                        <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource H.Text}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>

                <!-- ================================================= GENERAL -->
                <StackPanel x:Name="PageGeneral" Visibility="Collapsed">
                    <Border Style="{StaticResource H.Panel}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Start when I sign in" Style="{StaticResource RowTitle}"/>
                                <CheckBox x:Name="Autostart" Grid.Column="1" Style="{StaticResource H.Toggle}" Click="Autostart_Click"/>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Picture quality" Style="{StaticResource RowTitle}"/>
                                <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="QualityLight" GroupName="Quality" Style="{StaticResource H.Segment}" Content="Light" Click="Quality_Click" ToolTip="Easiest on your graphics chip"/>
                                        <RadioButton x:Name="QualityBalanced" GroupName="Quality" Style="{StaticResource H.Segment}" Content="Balanced" Click="Quality_Click"/>
                                        <RadioButton x:Name="QualityBest" GroupName="Quality" Style="{StaticResource H.Segment}" Content="Best" Click="Quality_Click" ToolTip="Every pixel of your screen"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="On battery" Style="{StaticResource RowTitle}"/>
                                <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="BatEco" GroupName="Bat" Style="{StaticResource H.Segment}" Content="Save power" Click="Wallpaper_Changed"/>
                                        <RadioButton x:Name="BatStatic" GroupName="Bat" Style="{StaticResource H.Segment}" Content="Still" Click="Wallpaper_Changed"/>
                                        <RadioButton x:Name="BatFull" GroupName="Bat" Style="{StaticResource H.Segment}" Content="Full" Click="Wallpaper_Changed"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,26,0,0" HorizontalAlignment="Center">
                        <Image x:Name="AboutIcon" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Harbor" FontFamily="{DynamicResource H.Display}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock x:Name="AboutVersion" Foreground="{DynamicResource H.TextDim}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        <TextBlock Text="Made by Yusuf Yunus" ToolTip="MUHAHAHAHHHA" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Foreground="{DynamicResource H.TextDim}" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" Margin="0,12,0,0" LineHeight="18">
                            Inspired by WinDock by Ihsan Maulana Hamdani (MIT). Informed by Lively Wallpaper, Seelen UI, LuminWallpaper, ManagedShell, RetroBar, Nectar, aero-dock and OneTaskBar. All code here was written from scratch.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                            <Button Style="{StaticResource H.Button}" Click="OpenNotices_Click" Margin="0,0,8,0">Licenses</Button>
                            <Button Style="{StaticResource H.Button}" Click="Quit_Click">Quit Harbor</Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
